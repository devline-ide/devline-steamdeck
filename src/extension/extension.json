{
  "schemaVersion": 1,
  "apiVersion": 6,
  "compatibility": {"minIdeVersion": "0.1.0", "capabilities": ["ui.webviews", "ui.settings", "ui.settings-scopes"]},
  "entryPoint": "devline.steamdeck.SteamDeckExtension",
  "libraries": ["lib/devline-steamdeck-0.1.0.jar", "lib/devline-deck-tools-0.1.0.jar", "lib/commons-compress-1.28.0.jar", "lib/commons-codec-1.19.0.jar", "lib/commons-io-2.20.0.jar", "lib/commons-lang3-3.18.0.jar"],
  "extension": {
    "schemaVersion": 1,
    "id": "devline.steamdeck",
    "version": "0.2.5",
    "name": {"en": "Steam Deck", "ru": "Steam Deck"},
    "description": {"en": "Build Linux games, prepare runtimes and deploy to Steam Deck.", "ru": "Сборка Linux-игр, подготовка runtime и запуск на Steam Deck."},
    "publisher": "DevLine",
    "icon": "data:image/png;base64,",
    "rpcNamespace": "steamDeck",
    "enabledByDefault": true,
    "commands": [{"id": "status", "title": {"en": "Steam Deck status", "ru": "Состояние Steam Deck"}}],
    "tools": []
  },
  "commandViews": {"status": "device"},
  "buildProfiles": [
    {"id": "devline.steamdeck.native", "name": {"en": "Steam Deck / Native", "ru": "Steam Deck / Native"}, "backend": "javafx", "platform": "linux", "architecture": "amd64", "requirements": ["java-25", "javafx-25", "gamepad"], "width": 1280, "height": 800, "fullscreen": true},
    {"id": "devline.steamdeck.chromium", "name": {"en": "Steam Deck / Chromium", "ru": "Steam Deck / Chromium"}, "backend": "desktop-web", "platform": "linux", "architecture": "amd64", "requirements": ["java-25", "chromium-152", "gamepad"], "width": 1280, "height": 800, "fullscreen": true}
  ],
  "webviews": [{"id": "device", "title": {"en": "Steam Deck", "ru": "Steam Deck"}, "html": "web/steamdeck.html", "methods": ["status", "prepare", "read", "cancel", "check", "deploy", "run", "stop", "logs", "frame", "deviceStatus", "remove", "plugin", "prepareSteamworks"]},
    {"id": "settings", "title": {"en": "Steam Deck", "ru": "Steam Deck"}, "html": "web/steamdeck.html", "location": "settings", "settingsScopes": ["user", "workspace"], "icon": "controller", "methods": ["status", "configure"]}]
}
